# DeepSeek API 配置
# 去 https://platform.deepseek.com 申请
# 警告: 不要把真实 key commit 到 git
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 委员会财务证据开关（2026-10-13）：on（默认）时 /api/v1/agent/decide 自带最近 2 个
# 报告期的财务摘要进证据包（24h TTL 缓存）。设 0/off/false 整体关闭（fail-open，
# 委员会照旧只看行情）。注意成本：证据包每个角色重发一遍，财务块约增加 8×几百 token。
AGENT_FUNDAMENTALS=1

# 委员会市场语境开关（2026-10-14）：on（默认）时证据包自带三块——大盘环境
# （指数/两市成交额/涨跌家数 + 个股相对上证强弱，腾讯行情+乐咕）、板块强弱
# （所属行业当日表现与排名，东财 push2，限流时该块自动缺席）、估值（PE/PB 近 5 年
# 分位，东财数据中心）。设 0/off/false 整体关闭。全市场共用一份 TTL 缓存，
# 成本摊薄后约 +3~4k token/次会议。
AGENT_MARKET_CONTEXT=1

# 智谱 Embedding (向量数据库)
# 去 https://bigmodel.cn/ 申请，注册送 2000 万 tokens
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_MODEL=embedding-2

# Spring Boot 后端
SPRING_BASE_URL=http://localhost:8080
# 也可以写成 JAVA_BASE_URL，两者等价（memory_store 优先读 JAVA_BASE_URL）
# 服务间鉴权：**双向**共用这一个密钥，必须与 Java 侧 application.properties 的
# internal.api-token（默认同值）保持一致：
#   · Java → 本服务：调用 /api/v1/agent/chat 等时携带 X-Internal-Token
#   · 本服务 → Java：调用 /api/v1/internal/memory/*（记忆账本）时携带同一个头
# 生产请改为强随机值，并在 docker-compose 的 INTERNAL_API_TOKEN 中覆盖。
#
# ⚠️ 这一项**必须配**（P4a 起为 fail-closed）：没配时本服务对 /api/v1/* 一律返回 503，
#    并在 /health 里把 status 标成 degraded。这里刻意不留"不配就放行"的兜底 ——
#    那种默认值意味着一次部署疏忽就等于所有内部接口裸奔（能读到用户全部记忆与对话）。
# 留空必填：照抄本文件启动会因未配置 token 而 503（fail-closed），这是刻意的
INTERNAL_API_TOKEN=

# ChromaDB 数据目录（VECTOR_BACKEND=chroma 时的索引落盘位置）
CHROMA_DATA_DIR=./chroma_data

# ==================== 记忆系统的向量检索 ====================
# 语义索引后端：
#   numpy （默认）进程内暴力余弦。单用户语料几十到几百条，这个规模它更快更简单，
#                 也没有"索引与事实源不一致"的问题。
#   chroma        落盘索引。多实例/多 worker 部署、或语料涨到几千条时再切。
# 切换只改这一个变量；Chroma 起不来会自动退回 numpy，不会影响对话。
VECTOR_BACKEND=numpy

# Embedding（语义召回用；不配就退化成纯关键词检索，功能不报错）
# 智谱：去 https://bigmodel.cn/ 申请（注册送 2000 万 tokens）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-2
# 注意：bge-m3 这类模型不支持 dimensions 参数，代码里刻意不发这个字段
# 向量缓存（同一段文本不重复调用接口）
EMBEDDING_CACHE_PATH=./.memory_index/embeddings.jsonl
