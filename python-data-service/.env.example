# DeepSeek API 配置
# 去 https://platform.deepseek.com 申请
# 警告: 不要把真实 key commit 到 git
DEEPSEEK_API_KEY=sk-your-key-here
# 多 key 池（2026-10-22）：逗号分隔，配置后优先于上面的单 key 变量。
# 限速在账号（key）级——多把 key = 多个独立限速桶；某把 key 持续 429 时只冷却它，
# 流量自动落到下一把。家用规模两把 key 通常就够了（一把自用 + 一把结算波峰专用）。
# DEEPSEEK_API_KEYS=sk-key-1,sk-key-2
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==================== 用户自带 Key（BYOK，2026-10-25） ====================
# env 里这套供应商只服务**系统级**调用（新闻解读等共享内容流水线）。
# 用户触发的 AI（聊天/委员会/盯盘/反思/记忆巩固）由 Java 把每个用户自己在
# 个人中心配的主/备 Key 随请求体下发（llm_providers 字段），本服务按调用接收
# 并完全替换 env 供应商——带该字段（哪怕空数组）= 用户级调用，绝不回落 env。
# 冷却/切换/重试机制两套供应商共用（见 llm_service.py）。

# ---- 备用 LLM 供应商（可选；只服务系统级任务，用户级备用槽在个人中心配）----
# 主供应商持续过载时自动冷却 10 分钟（LLM_PROVIDER_COOLDOWN 可调）并切到这里的
# OpenAI 兼容端点，恢复后自动切回。三个都填才启用。
# LLM_FALLBACK_BASE_URL=https://api.siliconflow.cn
# LLM_FALLBACK_API_KEY=sk-xxx
# LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct
# 智谱的兼容端点路径不同：base 配 https://open.bigmodel.cn/api/paas/v4、后缀配 /chat/completions
# LLM_FALLBACK_CHAT_PATH=/v1/chat/completions

# 委员会财务证据开关（2026-10-13）：on（默认）时 /api/v1/agent/decide 自带最近 2 个
# 报告期的财务摘要进证据包（24h TTL 缓存）。设 0/off/false 整体关闭（fail-open，
# 委员会照旧只看行情）。注意成本：证据包每个角色重发一遍，财务块约增加 8×几百 token。
AGENT_FUNDAMENTALS=1

# 委员会市场语境开关（2026-10-14）：on（默认）时证据包自带三块——大盘环境
# （指数/两市成交额/涨跌家数 + 个股相对上证强弱，腾讯行情+乐咕）、板块强弱
# （所属行业当日表现与排名，东财 push2，限流时该块自动缺席）、估值（PE/PB 近 5 年
# 分位，东财数据中心）。设 0/off/false 整体关闭。全市场共用一份 TTL 缓存，
# 成本摊薄后约 +3~4k token/次会议。
AGENT_MARKET_CONTEXT=1

# ==================== K 线取数同源退避重试（2026-10-21） ====================
# 腾讯日线 / 新浪分钟线取数失败（超时/连接/解析失败）时的同源重试，不换源、
# 不碰复权口径（2026-10-19/20 事故：ifzq 拒服 100+ 分钟，单次请求直接判死，
# 两天日线结算 data_unavailable）。
# · ATTEMPTS 是总尝试次数（含第一次）；BACKOFF 指数退避基数（2s → 2s/4s）；
# · 单页最坏 15s×3 + 2s + 4s ≈ 51s，仍在 Java evaluate-bar 60s 超时内，
#   多页区间查询最坏耗时约增 3 倍（仅源整段宕时发生，原本也失败）；
# · "正常返回但为空"不重试——空是源的正常回答（新股/超出源头历史）。
KLINE_RETRY_ATTEMPTS=3
KLINE_RETRY_BACKOFF_S=2.0

# ==================== 终审角色路由（2026-10-18，P0） ====================
# 委员会里出结论的两棒（trader / risk_judge）路由到推理模型，辩论角色保持
# DEEPSEEK_MODEL（deepseek-chat）控成本。事件驱动门控下没几次会，成本可控。
# · 置空（COMMITTEE_REASONER_MODEL=）即整体关闭，回到全员 deepseek-chat；
# · reasoner 的思考吃 completion 预算（默认 2000）且更慢（默认 90s/棒）；
# · 改这里的默认值或切换模型后，必须跑 scripts/run_regression.py 的 scenario
#   门禁对比解析失败率（SKIP_AGENT_UNPARSABLE 占比）——reasoner 对输出格式的
#   服从性弱于 chat 模型，这是切流前唯一的安全网。
COMMITTEE_REASONER_MODEL=deepseek-reasoner
COMMITTEE_REASONER_MAX_TOKENS=2000
COMMITTEE_REASONER_TIMEOUT_S=90

# Spring Boot 后端
SPRING_BASE_URL=http://localhost:8080
# 也可以写成 JAVA_BASE_URL，两者等价（memory_store 优先读 JAVA_BASE_URL）
# 服务间鉴权：**双向**共用这一个密钥，必须与 Java 侧 application.properties 的
# internal.api-token（默认同值）保持一致：
#   · Java → 本服务：调用 /api/v1/agent/chat 等时携带 X-Internal-Token
#   · 本服务 → Java：调用 /api/v1/internal/memory/*（记忆账本）时携带同一个头
# 生产请改为强随机值，并在 docker-compose 的 INTERNAL_API_TOKEN 中覆盖。
#
# ⚠️ 这一项**必须配**（P4a 起为 fail-closed）：没配时本服务对 /api/v1/* 一律返回 503，
#    并在 /health 里把 status 标成 degraded。这里刻意不留"不配就放行"的兜底 ——
#    那种默认值意味着一次部署疏忽就等于所有内部接口裸奔（能读到用户全部记忆与对话）。
# 留空必填：照抄本文件启动会因未配置 token 而 503（fail-closed），这是刻意的
INTERNAL_API_TOKEN=

# ChromaDB 数据目录（VECTOR_BACKEND=chroma 时的索引落盘位置）
CHROMA_DATA_DIR=./chroma_data

# ==================== 记忆系统的向量检索 ====================
# 语义索引后端：
#   numpy （默认）进程内暴力余弦。单用户语料几十到几百条，这个规模它更快更简单，
#                 也没有"索引与事实源不一致"的问题。
#   chroma        落盘索引。多实例/多 worker 部署、或语料涨到几千条时再切。
# 切换只改这一个变量；Chroma 起不来会自动退回 numpy，不会影响对话。
VECTOR_BACKEND=numpy

# Embedding（语义召回用；不配就退化成纯关键词检索，功能不报错）
# 任何 OpenAI 兼容的 /embeddings 端点均可，三个变量配齐才启用。例如硅基流动：
#   去 https://siliconflow.cn/ 申请 key，BAAI/bge-m3 免费额度足够个人用
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 例：https://api.siliconflow.cn/v1
EMBEDDING_MODEL=
# 例：BAAI/bge-m3
# 注意：bge-m3 这类模型不支持 dimensions 参数，代码里刻意不发这个字段
# 向量缓存（同一段文本不重复调用接口）
EMBEDDING_CACHE_PATH=./.memory_index/embeddings.jsonl

# ==================== fanout 并行子调研（2026-10-20） ====================
# fanout_research 工具：主 agent 把可拆解的问题（多标的横向比较/跨板块梳理）拆成
# 2-5 个子任务，各自带干净上下文并行查证后汇总。orchestrator-worker 形态，
# 与串行辩论的委员会互补（fanout 买覆盖面，委员会买结论可靠性）。
# · 每次调用还有硬闸：贵重配额每轮 3 次、每 worker ≤6 步 ≤8 次工具调用、
#   单次总 token 上限（FANOUT_TOTAL_TOKEN_BUDGET）、共用下方日预算线；
# · 成本量级：一次满配 fanout ≈ 十几轮普通工具调用的 token，默认参数下
#   上限约 3 万 token/次。
FANOUT_ENABLED=1
FANOUT_MAX_SUBTASKS=5
FANOUT_WORKER_MAX_STEPS=6
FANOUT_TOTAL_TOKEN_BUDGET=30000
FANOUT_WORKER_TIMEOUT_S=150

# 全局 LLM 日预算（0 = 不限）：委员会与 fanout 共用同一条线（Asia/Shanghai 日滚动）
# 2026-10-22 起：用量到 70%/90%/100% 时各发一次 WARNING 日志，并在 /health 的
# metering.quota 段可见（used/pct/alerts）——结算波峰烧了多少、什么时候该加 key，
# 看这里而不是等用户报障。
LLM_DAILY_TOKEN_BUDGET=0

# ==================== MCP 工具挂载（2026-10-20） ====================
# 把远端 MCP 服务器的**只读**工具装进工具注册表（预算/熔断/TTL/注入防护包裹
# 全部自动生效）。挂载后的 MCP 工具默认对模型可见（2026-10-20 用户决策）；
# MCP_DEFAULT_VISIBLE=0 可整体隐藏（第三方服务器质量不可预知时的紧急闸）。
#
# 默认接线（docker-compose 已带同样的默认值）：fetch 服务器以 stdio 子进程
# 方式跑在 python 容器内——requirements 里的 mcp-server-fetch（官方 Python
# 参考实现；官方 Docker 镜像是纯 stdio 的，没必要为它多跑一个容器）。
# 它给 agent 补上"抓网页转 markdown"的能力：政策原文、公告页、
# akshare/东财之外的资讯。注意：容器里没有 Node，Readability 走纯 Python
# 模式，复杂 JS 页面可能提取不出正文（文章类页面正常）。
#
# 每台服务器一段配置（短名只允许字母数字下划线）。通用键：
#   MCP_<NAME>_TRANSPORT   http（Streamable HTTP，需 URL）| stdio（本地子进程，需 COMMAND/ARGS）
#   MCP_<NAME>_ALLOW_TOOLS 逗号分隔的工具白名单：服务器没声明 readOnlyHint 的工具，
#                          运营者显式放行也按只读挂载（Python 参考实现普遍不填标注）
#   MCP_<NAME>_TRUST       low|medium（high 一律拒绝）；TTL_S 结果缓存；MAX_TOOLS 挂载数上限
MCP_ENABLED=1
MCP_SERVERS=fetch
MCP_DEFAULT_VISIBLE=1
MCP_FETCH_TRANSPORT=stdio
MCP_FETCH_COMMAND=python
MCP_FETCH_ARGS=-m,mcp_server_fetch,--ignore-robots-txt
MCP_FETCH_ALLOW_TOOLS=fetch
MCP_FETCH_TRUST=low
MCP_FETCH_TTL_S=300
#
# 接一台远程 HTTP 服务器的样子：
#   MCP_SERVERS=fetch,mydb
#   MCP_MYDB_TRANSPORT=http
#   MCP_MYDB_URL=http://10.0.0.5:8080/mcp
#   MCP_MYDB_API_KEY=...            # 可选：Authorization Bearer

