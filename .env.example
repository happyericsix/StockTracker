# docker compose 部署用的根目录 .env —— 复制为 .env 后填写（.env 已 gitignore，绝不进仓库）
#   cp .env.example .env
#
# 注意（2026-10-04 测试发现并修复）：后端与 MySQL 共用 MYSQL_ROOT_PASSWORD 这一个变量。
# 历史版本里后端读的是 MYSQL_PASSWORD，只设一个会出现"MySQL 改了密码、后端还拿 123456 连不上"的部署陷阱。

# MySQL root 密码（mysql 容器与 Java 后端共用）
MYSQL_ROOT_PASSWORD=change-me

# Java ↔ Python 内部接口共享令牌（两个容器必须一致；未配置 compose 会拒绝启动）
# 生成方式：openssl rand -hex 24
INTERNAL_API_TOKEN=change-me-too

# DeepSeek API Key —— ⚠️ 2026-10-25 BYOK 上线后这只服务**系统级**任务（新闻解读等共享
# 内容流水线）。用户触发的 AI（聊天/交易委员会/盯盘/反思/复盘/记忆巩固）一律花用户
# 自己在个人中心绑定的 Key（未绑定则降级模板回复），不再烧部署者的额度。
DEEPSEEK_API_KEY=

# 用户 LLM Key 的加密密钥（AES/GCM，加密 user_llm_configs 表里用户保存的 Key）
# 生成方式：openssl rand -hex 24   不配置则用户无法保管 Key（界面会明示），应用可正常启动
# ⚠️ 换了它，所有用户已保存的 Key 都需要重新输入
LLM_AES_KEY=

# ======== 安全开关（2026-10-05 安全检查新增）========

# 注册开关：先保持 true 注册你自己的账号，然后改成 false 并 `docker compose up -d` 重建。
# （2026-10-25 BYOK 后用户 AI 花自己的 Key；这条约束的是新闻解读等系统级额度与注册滥用面。）
AUTH_REGISTRATION_ENABLED=true

# 同花顺扫码绑定凭证的 AES 加密密钥（不用同花顺绑定可不填，功能会 fail-closed 但不影响其他）
# 生成方式：openssl rand -hex 24   ⚠️ 换了它，已绑定的同花顺账号需要重新扫码
# ⚠️ 历史版本的默认值 dev-only-key-change-me-0000 已随 git 历史公开，绝不可再用（2026-10-15 轮换）
THS_AES_KEY=

# ---- 备用 LLM 供应商（2026-10-15，可选但强烈建议）----
# 主供应商（DeepSeek）持续过载时自动冷却 10 分钟并切到这里的 OpenAI 兼容端点，
# 恢复后自动切回。三个都填才启用。可选：硅基流动/Moonshot/智谱等任意 OpenAI 兼容服务。
# ⚠️ 只服务系统级任务；用户级调用的备用槽是用户自己在个人中心配的（同样这套切换机制）。
# LLM_FALLBACK_BASE_URL=https://api.siliconflow.cn
# LLM_FALLBACK_API_KEY=sk-xxx
# LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct
